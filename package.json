{
  "name": "game-weather-command",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Weather Command — standalone deterministic middle-school weather forecasting game (GAME-336 / GAME-338).",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test --config=playwright.config.ts",
    "test:host": "npm run build && npm run test:host:run",
    "test:host:run": "playwright test --config=playwright.host.config.ts",
    "serve:nested-host": "node scripts/nested-host-server.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:privacy": "node scripts/check-privacy-surface.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run check:architecture && npm run build && npm run check:privacy",
    "release:build": "npm run build && npm run release:manifest",
    "release:manifest": "node scripts/create-release-manifest.mjs dist",
    "release:check": "node scripts/create-release-manifest.mjs dist --check"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
